# Template for `npm run new -- "Title"`, which fills in id and title.
# The build rejects it until url is filled in; delete optional fields you don't use.
type: Resource
id: null                  # ULID, minted by `npm run new`
title: null
url: null                 # one URL, or a list (website, YouTube, Spotify, ...)
rss: null                 # optional: feed for the "last episode" box
# unavailable:            # optional: it existed but stopped working; the card is kept, greyed out
#   since: '2026-11'      # YYYY, YYYY-MM or YYYY-MM-DD
#   note:                 # optional: what happened (markdown)
#     en: >-
#       ...
language: en              # BCP 47 code, or a list: [en, ja]; delete if none
image: null               # optional: {contentUrl: https://...}
description:
  en: >-
    What the resource is, in its own terms (markdown).
comment:
  en: >-
    Why it is on the list (markdown).
curatedBy: agent:FSM      # who selected it and wrote the comment (martial.is/agent/FSM)
tags:                     # format, topic and place
  - website
# about:                  # optional: martial.is entities (person, org, style, place, event, source)
#   - person: 01KJJAWN28MWKKSN4J02MVY1S1
#     name: Kanō Jigorō
# sameAs:                 # optional: the same resource elsewhere, e.g. its martialis Source
#   - https://martial.is/entity/01M0DCY9PE27WPF24T770ND0N8
